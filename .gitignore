.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to share your .python-version.
#   For an app, this is usually fine to prevent conflicts.
.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in git and NOT on .gitignore
# Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock is managed by 'poetry lock' and should be added to git
# poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock is managed by 'pdm lock' and should be added to git
# pdm.lock

