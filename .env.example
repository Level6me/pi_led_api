# Pi LED Control API Configuration (v2.1)
PORT=8080
HOST=0.0.0.0

# 多设备 Token 配置（格式：token1:设备名称1,token2:设备名称2）
# 系统将根据传入的 Token 自动识别调用设备并记录专属审计日志
API_TOKENS=feishu_token_123:飞书机器人,ios_token_456:iPhone15快捷指令,ha_token_789:HomeAssistant,admin_token_000:Web管理控制台

# 单设备备用 Token（若未配置 API_TOKENS，则采用此配置）
# API_TOKEN=your_single_token_here
